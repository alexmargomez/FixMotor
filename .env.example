# ==========================================
# Variables de Entorno - Docker Compose (Raíz)
# ==========================================

# Puertos (Solo cambias el puerto aquí y se aplica en todo el archivo)
BACKEND_PORT=7000
FRONTEND_PORT=5173
DB_EXTERNAL_PORT=3309

# Base de Datos (MariaDB)
DB_CONNECTION=mariadb
DB_HOST=fixmotor-mariadb
DB_PORT=3306
DB_DATABASE=fixmotor
DB_USERNAME=fixmotor_user
DB_PASSWORD=fixmotor_pass
DB_ROOT_PASSWORD=fixmotor_pass

# Backend (Laravel API)
APP_NAME="FixMotor"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:${BACKEND_PORT}
PHP_CLI_SERVER_WORKERS=4

# Frontend (React + Vite)
VITE_API_URL=/api
